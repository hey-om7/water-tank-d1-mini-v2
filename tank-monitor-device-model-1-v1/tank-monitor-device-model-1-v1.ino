// Return false while the device is doing something an OTA reboot would ruin
// (recording, actuating, mid-transaction). OTA waits and re-checks.
static bool appCanUpdate() {
  return true;
}

// Runs right before a firmware download starts: stop peripherals, show an
// "updating" screen, close files.
static void appBeforeFlash() {
  LOGI("APP", "preparing for firmware update");
}

// Runs right before a restart requested from the FirmwareManager console
// (Devices -> device -> Restart): save state, park actuators. Keep it short.
static void appBeforeRestart() {
  LOGI("APP", "preparing for remote restart");
}

static void appSetup() {
  // Initialise your sensors, displays, inputs ... here.
  LOGI("APP", "%s ready", DEVICE_NAME);
}

static void appLoop() {
  // Your non-blocking business logic here.

  // Example: periodic health line. Reaches the console only when DEBUG is
  // enabled for this device in FirmwareManager -> Devices -> Logging.
  static uint32_t lastHealth = 0;
  if (millis() - lastHealth >= 60000UL) {
    lastHealth = millis();
    LOGD("SYS", "up=%lus heap=%u minHeap=%u rssi=%d mqtt=%d queued=%u",
         static_cast<unsigned long>(millis() / 1000UL), ESP.getFreeHeap(), ESP.getMinFreeHeap(),
         WiFi.status() == WL_CONNECTED ? WiFi.RSSI() : 0, static_cast<int>(RemoteLog::connected()),
         static_cast<unsigned>(RemoteLog::queued()));
  }
}

// =============================================================================
// Plumbing
// =============================================================================

static const char* resetReason() {
  switch (esp_reset_reason()) {
    case ESP_RST_POWERON:   return "power-on";
    case ESP_RST_SW:        return "software";
    case ESP_RST_PANIC:     return "panic";
    case ESP_RST_INT_WDT:   return "int-wdt";
    case ESP_RST_TASK_WDT:  return "task-wdt";
    case ESP_RST_WDT:       return "wdt";
    case ESP_RST_BROWNOUT:  return "brownout";
    case ESP_RST_DEEPSLEEP: return "deep-sleep";
    default:                return "other";
  }
}

void setup() {
  Serial.begin(115200);
  delay(200);
  RemoteLog::init();  // buffer from the first line; shipped once MQTT connects

  MqttLogging::setFirmwareVersion(OtaUpdates::currentVersion().c_str());
  LOGI("BOOT", "%s (%s) v%s booting - reset=%s heap=%u", DEVICE_NAME, MODEL_NUMBER,
       OtaUpdates::currentVersion().c_str(), resetReason(), ESP.getFreeHeap());
  {
    uint8_t mac[6];
    esp_read_mac(mac, ESP_MAC_WIFI_STA);  // valid before Wi-Fi starts
    LOGI("BOOT", "Wi-Fi MAC %02X:%02X:%02X:%02X:%02X:%02X  <- register this in FirmwareManager -> Devices",
         mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
  }

  OtaUpdates::setCanUpdate(appCanUpdate);
  OtaUpdates::setBeforeFlash(appBeforeFlash);
  MqttLogging::setBeforeRestart(appBeforeRestart);

  WifiConnect::begin();
  MqttLogging::loop();  // start remote logging now if Wi-Fi is up

  appSetup();
}

void loop() {
  WifiConnect::loop();
  MqttLogging::loop();
  OtaUpdates::loop();  // boot check, then every OTA_CHECK_INTERVAL_MS
  appLoop();
  delay(1);
}
